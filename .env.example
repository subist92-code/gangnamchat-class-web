# 강남챗 클래스 — 환경변수 예시. 실제 값은 .env.local 에 두고 절대 커밋하지 않는다(H-6).
# 이 파일에 실제 키를 적지 않는다.

# Supabase (클래스 전용 신규 프로젝트 · 본체와 비공유 · C-071 ②)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 통로 함수(스모크 ④) 이름 — 배포된 Edge Function 이름
VITE_PASSTHROUGH_FUNCTION=passthrough-smoke

# 모델 ID — 값이 사는 유일한 곳은 여기와 src/config/models.ts 뿐이다(C-051 · 리터럴 금지)
VITE_MODEL_TRANSCRIBE=claude-opus-5
VITE_MODEL_NARRATIVE=claude-sonnet-5
VITE_MODEL_CHAT=claude-haiku-4-5

# BYOK API 키는 환경변수에 두지 않는다(H-2). 선생이 화면에서 입력하고 메모리에만 산다.
