# 강남챗 클래스 2기 — Pages Function 환경변수 (이름만 · 값은 Cloudflare Pages 설정에)
# H-6: 이 파일에 실제 값을 적지 않는다. 커밋되는 유일한 env 파일이다.

# 클래스 Supabase 프로젝트 (C2-064)
SUPABASE_URL=
# 새 키 체계의 secret 키(sb_secret_…). 레거시 서비스 롤 키는 받지 않는다(2026-09-06 유출로 폐기).
SUPABASE_SECRET_KEY=

# 전송 (C2-064 · Resend)
RESEND_API_KEY=
MAIL_FROM=

# 배포물 정적 URL 2개 — 패키지 · 교사용 킷 (지시서 02(2기) v2.0 §4 · 두 zip 은 합치지 않는다)
PACKAGE_URL=
KIT_URL=

# 남용 상한 — 숫자는 코드·문서가 아니라 설정에만 둔다(R-1 · C2-065)
RATE_EMAIL_PER_DAY=
RATE_IP_PER_DAY=

# IP 해시용 소금 (무작위 32바이트 이상)
IP_HASH_SALT=
